{
  "name": "bosun-browser",
  "version": "0.10.0",
  "description": "Bosun — the boatswain browser for agents: a self-hosted, multi-tenant browser service with human handoff, over MCP / MCPL.",
  "type": "module",
  "bin": {
    "bosun-browser": "src/server.mjs",
    "bosun-mcp-stdio": "bin/bosun-mcp-stdio.mjs"
  },
  "main": "src/server.mjs",
  "scripts": {
    "start": "node src/server.mjs",
    "test": "node --test --test-concurrency=4 test/*.test.mjs",
    "test:engines": "node scripts/test-engines.mjs",
    "measure:engines": "node scripts/measure-engines.mjs"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "playwright": "1.64.1",
    "ws": "8.22.0",
    "zod": "4.6.7"
  },
  "optionalDependencies": {
    "camoufox-js": "0.13.0",
    "patchright": "1.64.1"
  }
}
