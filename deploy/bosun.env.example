# Example EnvironmentFile for the systemd unit (see docs/DEPLOY-SYSTEMD.md).
# Install as /etc/bosun/bosun.env, owner root:bosun, mode 0640. REAL TOKENS NEVER GO INTO THE REPOSITORY.
# Generate one per tenant: openssl rand -hex 32

# --- tenants ---
BROWSER_TOKENS=ops:REPLACE_ME_32_BYTES_HEX,swarm:REPLACE_ME_OTHER_32_BYTES_HEX
# Subagents get a read-only tenant: ephemeral sessions and page tools only, no profiles, no handoff.
BROWSER_TOKEN_POLICIES=swarm=ephemeral
BROWSER_EPHEMERAL_MAX_SESSIONS=2

# --- where each tenant may go (fork addition) ---
# Entries are separated by ";", hosts within an entry by ",". Patterns: host, *.host, host:port, [::1]:port, *.
# A named tenant reaches the network only through its own forward proxy inside the service, which checks every
# connection (navigations, redirect hops, subresources, WebSockets, workers) and resolves DNS itself. A name that
# resolves into loopback or a private range needs that address in the list too, so name local services by address.
# A tenant that is not named here may reach any host, with no proxy at all.
BROWSER_TENANT_ALLOW=ops=*.example.org,example.org,127.0.0.1:4848; swarm=*.example.org

# --- features (off/minimal by default in this fork) ---
FEATURES_MEETINGS=0
FEATURES_ENGINES=chromium
# Downloads a page starts. 0 = the browser refuses them; with 1, these budgets bound what stays on disk.
DOWNLOADS=0
#DOWNLOADS_MAX_MB=100
#DOWNLOADS_TOTAL_MAX_MB=500
# Chromium's own sandbox. Leave at 1; the service refuses to start if the host cannot provide it (see
# docs/DEPLOY-SYSTEMD.md §3a). 0 runs the browser unsandboxed and is logged as a warning at every start.
CHROMIUM_SANDBOX=1

# --- listeners: both on loopback; the live view is published by `tailscale serve`, MCP is not published ---
WS_HOST=127.0.0.1
WS_PORT=7360
LIVE_HOST=127.0.0.1
LIVE_PORT=7350
# The URL the human's phone opens — the `tailscale serve` address of this node, not the loopback port.
LIVE_BASE_URL=https://bosun.example.ts.net
HANDOFF_TTL_SEC=900

# --- limits ---
MAX_SESSIONS=3
MAX_SESSIONS_PER_TENANT=2
MAX_CONNECTIONS=16
IDLE_TIMEOUT_SEC=900
TZ=Europe/Vienna

# Screenshots stay in memory unless you ask for files (they are 0600 and deleted with the session).
# SAVE_SHOTS=1
# Never set ALLOW_NO_TOKEN=1 on a shared host: it hands every local process a full-policy tenant.
